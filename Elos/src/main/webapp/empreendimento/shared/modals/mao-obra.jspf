<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ taglib uri="jakarta.tags.fmt" prefix="fmt" %>
<fmt:setLocale value="pt_BR"/>

<div id="mostUsedLaborModal" class="modal action-modal">
    <div class="modal-content">
        <span class="close-button">×</span>
        <h2>Mãos de Obra Mais Usadas</h2>
        <p>A seguir, uma lista das mãos de obra que mais acumularam horas nos produtos cadastrados.</p>
        <ol class="modal-list">
            <c:choose>
                <c:when test="${not empty dashboardData.todasMaisUtilizadas}">
                    <c:forEach var="item" items="${dashboardData.todasMaisUtilizadas}">
                        <li>
                            <strong><c:out value="${item.nome}"/>:</strong> 
                            Total de <fmt:formatNumber value="${item.total_horas}" maxFractionDigits="1" /> horas registradas em produtos.
                        </li>
                    </c:forEach>
                </c:when>
                <c:otherwise>
                     <li>Nenhuma hora de mão de obra associada a produtos ainda.</li>
                </c:otherwise>
            </c:choose>
        </ol>
        <button class="modal-action-button" onclick="window.location.href='${pageContext.request.contextPath}/empreendimento/produto/listagem'">Ver Produtos</button>
    </div>
</div>

<div id="highValueLaborModal" class="modal">
    <div class="modal-content">
        <span class="close-button">×</span>
        <h2>Mãos de Obra de Maior Valor/Hora</h2>
        <p>Lista detalhada de mãos de obra com o maior valor por hora cadastrado.</p>
        <ol class="modal-list">
             <c:choose>
                <c:when test="${not empty dashboardData.todasMaisCaras}">
                    <c:forEach var="item" items="${dashboardData.todasMaisCaras}">
                        <li>
                            <strong><c:out value="${item.nome}"/>:</strong> 
                            <fmt:formatNumber value="${item.custoHora}" type="currency" />/h
                        </li>
                    </c:forEach>
                </c:when>
                <c:otherwise>
                     <li>Nenhuma mão de obra cadastrada.</li>
                </c:otherwise>
            </c:choose>
        </ol>
    </div>
</div>

<div id="recentLaborModal" class="modal">
    <div class="modal-content">
        <span class="close-button">×</span>
        <h2>Últimas Mãos de Obra Cadastradas</h2>
        <p>Registros de mão de obra mais recentes adicionados ao sistema.</p>
        <ul class="modal-list">
            <c:choose>
                <c:when test="${not empty dashboardData.ultimasCadastradas}">
                    <c:forEach var="item" items="${dashboardData.ultimasCadastradas}">
                        <li>
                            <strong><c:out value="${item.nome}"/></strong> 
                            (Cadastrada em: <c:out value="${item.createdAt}"/>) - 
                            <fmt:formatNumber value="${item.custoHora}" type="currency"/>/h
                        </li>
                    </c:forEach>
                </c:when>
                <c:otherwise>
                    <li>Nenhuma mão de obra cadastrada recentemente.</li>
                </c:otherwise>
            </c:choose>
        </ul>
         <button class="modal-action-button" onclick="window.location.href='${pageContext.request.contextPath}/empreendimento/mao-obra/listagem'">Ver Todas</button>
    </div>
</div>